# Supabase: same project as the mobile app. Copy to .env and set values.
# Get URL and anon key from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Storage bucket for event image uploads (default: event-images)
VITE_SUPABASE_STORAGE_BUCKET=event-images